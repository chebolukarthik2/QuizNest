# ============================================================
# LOCAL DEVELOPMENT ONLY
# These are written automatically when you run `npx convex dev`.
# You normally never type these in by hand — this file just
# documents what will appear in your real .env.local.
# ============================================================

# The URL your frontend uses to reach your Convex deployment.
VITE_CONVEX_URL=

# The dev deployment slug (e.g. dev:some-name-123), used locally
# by the Convex CLI. Set automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=

# Convex site URL used by auth during local development.
CONVEX_SITE_URL=http://localhost:5173


# ============================================================
# VERCEL / PRODUCTION DEPLOYMENT ONLY
# Do NOT put this in .env.local. Set this ONE variable in the
# Vercel dashboard: Project -> Settings -> Environment Variables.
#
# Get the value from: dashboard.convex.dev -> your project
# -> Settings -> Deploy Keys -> Generate Production Deploy Key
#
# It looks like: prod:some-name-123|eyJ2MiI6...(long token)
#
# This is DIFFERENT from CONVEX_DEPLOYMENT above — that's just a
# name, this is the actual secret access token. `npx convex deploy`
# reads CONVEX_DEPLOY_KEY (and only this exact name) to
# authenticate during the Vercel build, and it sets
# VITE_CONVEX_URL automatically for you at build time.
# ============================================================
# CONVEX_DEPLOY_KEY=
